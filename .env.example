# IRoom Configuration
# Copy this file to .env and update values

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
# Container platforms (Hugging Face Spaces, Render, Fly.io) set PORT
# automatically and it takes precedence over SERVER_PORT.
# PORT=7860

# Database
# DB_DRIVER selects the backend: sqlite (default) or postgres.
# Setting DATABASE_URL (or SUPABASE_DB_URL) implies DB_DRIVER=postgres.
DB_DRIVER=sqlite

# --- SQLite (default, local development) ---
DATABASE_PATH=iroom.db

# --- Postgres / Supabase (required for ephemeral container hosting) ---
# Supabase: Project Settings -> Database -> Connection string -> URI
# Must use the "Session pooler" (port 5432) or "Transaction pooler" (6543).
# Example:
# DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-us-west-1.pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_URL=
# SUPABASE_DB_URL=
# DB_SSLMODE=require

# Postgres connection pool (free tiers have low connection limits)
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=0

# JWT
JWT_SECRET=change-me-in-production-use-random-string
JWT_ACCESS_EXPIRY=15
JWT_REFRESH_EXPIRY=10080

# Upload
UPLOAD_MAX_SIZE=52428800
UPLOAD_DIR=uploads

# Rate Limiting (set to true to disable for local dev/e2e)
RATE_LIMIT_DISABLED=true

# External API
EXTERNAL_API_KEY=change-me-external-api-key

# WebRTC (set PUBLIC_IP to your VPS public IP for internal-only WebRTC)
WEBRTC_PUBLIC_IP=
WEBRTC_STUN_PORT=3478
WEBRTC_TURN_PORT=3479
WEBRTC_TURN_SECRET=
WEBRTC_UDP_PORT=8081
